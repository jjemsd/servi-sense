# Copy this to .env and fill in real values for local development.
# .env should NEVER be committed to git.

# Leave DATABASE_URL unset to use SQLite locally (servisense.db file).
# DATABASE_URL=postgresql://user:pass@localhost:5432/servisense

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Environment: development | production
ENV=development
